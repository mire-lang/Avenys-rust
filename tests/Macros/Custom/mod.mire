fn custom_value: () :i64 { return 42 }

@[macro!]
pub fn ensure_answer: (value :i64) :bool {
    return value == 42
}

@[test]
pub fn custom_macro_fixture_is_real: () :bool {
    set value = custom_value()
    set verified = ensure_answer!(value)

    if !verified {
        return false
    }
    return value - 2 == 40
}
