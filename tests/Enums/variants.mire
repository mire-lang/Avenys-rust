// Enum variants with payload data

enum Phase { Draft Published Archived }

fn phase_is_published: (phase :Phase) :bool {
    match phase { Phase.Published { return true } _ { return false } }
    return false
}

@[test]
pub fn draft_variant: () :bool { return phase_is_published(Phase.Draft) == false }

@[test]
pub fn published_variant: () :bool { return phase_is_published(Phase.Published) }

@[test]
pub fn archived_variant: () :bool { return phase_is_published(Phase.Archived) == false }

@[test]
pub fn enum_value_reassignment: () :bool {
    set phase = Phase.Draft mut
    set phase = Phase.Archived
    return phase != Phase.Draft
}

@[test]
pub fn enum_boolean_decision: () :bool { return phase_is_published(Phase.Published) && !phase_is_published(Phase.Draft) }

@[test]
pub fn enum_match_expression: () :bool {
    set phase = Phase.Published
    return phase_is_published(phase)
}

@[test]
pub fn distinct_variants: () :bool {
    return Phase.Draft != Phase.Published && Phase.Published != Phase.Archived
}
