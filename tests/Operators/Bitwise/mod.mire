// Bitwise operators: shift, AND, OR, XOR on integer values

@[test]
pub fn shift_left_by_three: () :bool {
    set value = 1
    set shifted = value << 3

    // Tests left shift by 3 positions: 1 << 3 = 8
    return shifted == 8
}

@[test]
pub fn bitwise_and_operation: () :bool {
    set a = 15
    set b = 8
    set and_result = a & b

    // Tests bitwise AND: 15 & 8 = 8
    return and_result == 8
}

@[test]
pub fn bitwise_or_operation: () :bool {
    set a = 3
    set b = 5
    set or_result = a | b

    // Tests bitwise OR: 3 | 5 = 7
    return or_result == 7
}

@[test]
pub fn bitwise_xor_operation: () :bool {
    set a = 6
    set b = 3
    set xor_result = a ^ b

    // Tests bitwise XOR: 6 ^ 3 = 5
    return xor_result == 5
}

// bits::<T>(value) — bit-level reinterpretation between same-width scalars.

@[test]
pub fn bitcast_f64_to_i64_and_back: () :bool {
    set d = 3.5
    set i = bits::i64(d)
    set back = bits::f64(i)

    // 3.5 is 0x401C000000000000, and the roundtrip must be exact.
    return i == 4615063718147915776 && back == 3.5
}

@[test]
pub fn bitcast_zero_has_all_zero_bits: () :bool {
    set z = bits::i64(0.0)
    return z == 0
}

@[test]
pub fn bitcast_identity_on_i64: () :bool {
    set a = 7
    return bits::i64(a) == 7
}

@[test]
pub fn bitcast_tiny_pattern_reads_as_denormal: () :bool {
    // Bit pattern 7 has no normalised f64 encoding, so it reads back as a
    // denormal: 7 * 2^-1074. This proves the bits moved and were not truncated.
    set tiny = bits::f64(7)
    return tiny > 0.0 && tiny < 0.000000000000001
}

@[test]
pub fn bitcast_preserves_nan_pattern: () :bool {
    // All-ones is a NaN payload; roundtripping must not normalise it away.
    set ones = bits::i64(-1)
    set as_float = bits::f64(ones)
    set again = bits::i64(as_float)
    return ones == again
}

@[test]
pub fn bitcast_i32_to_f32_keeps_width: () :bool {
    set small = 3 :i32
    set as_float = bits::f32(small)

    // Bit pattern 3 as f32 is a denormal, far below any normal float.
    return as_float > 0.0 && as_float < 0.0000001
}
