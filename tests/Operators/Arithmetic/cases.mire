// Arithmetic operator cases verified with final state

@[test]
pub fn addition_case_verified: () :bool {
    set a = 12
    set b = 5
    set result = a + b

    // Tests 12 + 5 equals 17
    return result == 17
}

@[test]
pub fn subtraction_case_verified: () :bool {
    set a = 12
    set b = 5
    set result = a - b

    // Tests 12 - 5 equals 7
    return result == 7
}

@[test]
pub fn multiplication_case_verified: () :bool {
    set a = 12
    set b = 5
    set result = a * b

    // Tests 12 * 5 equals 60
    return result == 60
}

@[test]
pub fn division_case_verified: () :bool {
    set a = 60
    set b = 5
    set result = a / b

    // Tests 60 / 5 equals 12
    return result == 12
}

@[test]
pub fn modulo_case_verified: () :bool {
    set a = 60
    set b = 7
    set result = a % b

    // Tests 60 % 7 equals 4
    return result == 4
}

@[test]
pub fn negative_addition_case_verified: () :bool {
    set a = -4
    set b = 9
    set result = a + b

    // Tests -4 + 9 equals 5
    return result == 5
}

@[test]
pub fn arithmetic_chain_case_verified: () :bool {
    set a = 2
    set b = 3
    set c = 4
    set d = 5
    set result = a + b * c - d

    // Tests 2 + 3*4 - 9 ordering: 2 + 12 - 5 = 9
    return result == 9
}

@[test]
pub fn arithmetic_variables_case_verified: () :bool {
    set left = 6
    set right = 7
    set result = left * right

    // Tests 6 * 7 equals 42
    return result == 42
}
