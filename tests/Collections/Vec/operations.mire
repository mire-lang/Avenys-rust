// Vector operations use the real Mire collection implementation.
load mire::vec

@[test]
pub fn vector_len_after_push: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 10)
    set values = vec::push::i64(values 20)
    return vec::len(values) == 2
}

@[test]
pub fn vector_first_value: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 4)
    return vec::get::i64(values 0) == 4
}

@[test]
pub fn vector_second_value: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 4)
    set values = vec::push::i64(values 8)
    return vec::get::i64(values 1) == 8
}

@[test]
pub fn vector_three_values: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 1)
    set values = vec::push::i64(values 2)
    set values = vec::push::i64(values 3)
    return vec::len(values) == 3
}

@[test]
pub fn vector_empty_len: () :bool { set values = [] :vec[i64]
    return vec::len(values) == 0 }

@[test]
pub fn vector_negative_value: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values -5)
    return vec::get::i64(values 0) == -5
}

@[test]
pub fn vector_large_value: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 1000)
    return vec::get::i64(values 0) == 1000
}

@[test]
pub fn vector_mutable_sequence: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 2)
    set values = vec::push::i64(values 3)
    return vec::get::i64(values 0) + vec::get::i64(values 1) == 5
}

@[test]
pub fn vector_searches_and_slices_values: () :bool {
    set values = [] :vec[i64] mut
    set values = vec::push::i64(values 9)
    set values = vec::push::i64(values 3)
    set values = vec::push::i64(values 6)

    if !vec::contains::i64(values 6) {
        return false
    }
    set location = vec::index::i64(values 6)

    if location != 2 {
        return false
    }
    set selected = vec::slice(values 1 3)

    if vec::len(selected) != 2 {
        return false
    }
    return vec::get::i64(selected 0) == 3
}

@[test]
pub fn vector_clone_copies_the_length: () :bool {
    set source = [5 1 3] :vec[i64]
    set copy = vec::clone(source)
    return vec::len(copy) == 3
}

@[test]
pub fn vector_clone_copies_every_element: () :bool {
    set source = [5 1 3] :vec[i64]
    set copy = vec::clone(source)
    if vec::get::i64(copy 0) != 5 { return false }
    if vec::get::i64(copy 1) != 1 { return false }
    return vec::get::i64(copy 2) == 3
}

@[test]
pub fn vector_clone_of_a_single_element_keeps_that_element: () :bool {
    // The length is stored immediately before the first element, so a clone of
    // one element is where an off-by-one-word in the copy lands on top of the
    // data it just wrote.
    set source = [42] :vec[i64]
    set copy = vec::clone(source)
    return vec::len(copy) == 1 && vec::get::i64(copy 0) == 42
}

@[test]
pub fn vector_clone_of_an_empty_vector_is_empty: () :bool {
    set source = [] :vec[i64]
    set copy = vec::clone(source)
    return vec::len(copy) == 0
}

@[test]
pub fn vector_clone_is_independent_of_the_original: () :bool {
    // The copy has its own storage: growing it must not move the source, and
    // the source must keep the length it started with.
    set source = [1 2] :vec[i64]
    set copy = vec::clone(source) :vec[i64] mut
    set copy = vec::push::i64(copy 99)
    if vec::len(source) != 2 { return false }
    if vec::len(copy) != 3 { return false }
    if vec::get::i64(source 0) != 1 { return false }
    return vec::get::i64(copy 2) == 99
}

fn sum_through_reference: (values :&vec[i64]) :i64 {
    set total = 0 :i64 mut
    set index = 0 :i64 mut
    set count = vec::len(values)
    while index < count {
        set total += values[index]
        set index += 1
    }
    return total
}

fn double_through_reference: (values :&mut vec[i64]) {
    set index = 0 :i64 mut
    set count = vec::len(values)
    while index < count {
        set values[index] = values[index] * 2
        set index += 1
    }
}

@[test]
pub fn vector_index_reads_through_a_reference: () :bool {
    // `values` is `&vec[i64]`, not a value: indexing must auto-deref and still
    // produce the element rather than the vector pointer.
    set values = [7 11 13] :vec[i64]
    return sum_through_reference(values) == 31
}

@[test]
pub fn vector_index_writes_through_a_mutable_reference: () :bool {
    set values = [1 2 3] :vec[i64] mut
    double_through_reference(values)
    return values[0] == 2 && values[1] == 4 && values[2] == 6
}

@[test]
pub fn vector_sort_orders_in_place: () :bool {
    set values = [5 -1 4 4 2] :vec[i64] mut
    vec::sort(values)
    return values[0] == -1 && values[1] == 2 && values[2] == 4
        && values[3] == 4 && values[4] == 5
}

@[test]
pub fn vector_sort_empty_is_a_noop: () :bool {
    set values = [] :vec[i64] mut
    vec::sort(values)
    return vec::len(values) == 0
}

@[test]
pub fn vector_sort_single_element_stays_put: () :bool {
    set values = [42] :vec[i64] mut
    vec::sort(values)
    return vec::len(values) == 1 && values[0] == 42
}
