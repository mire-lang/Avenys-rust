// FFI: external C function interface verification

extern fn abs: (value :i64) :i64 lib "c"

@[test]
pub fn ffi_abs_positive: () :bool {
    set result = abs(42)
// Tests C extern abs function with positive value
    return result == 42
}

@[test]
pub fn ffi_abs_negative: () :bool {
    set result = abs(-42)
// Tests C extern abs function with negative value
    return result == 42
}
// ── Raw buffers: allocation, pointer arithmetic, byte writes ─────────
// This is the path that lets a project manipulate bytes from pure Mire instead
// of hand-writing a C helper. It depends on two things that did not work before:
// rt_ptr_add (no pointer arithmetic at all) and a working null check.

// Regression: `ptr == 0` was lowered to strcmp against an inttoptr'd literal,
// which dereferenced the null pointer. Every null check on a raw allocation
// segfaulted the process.

extern fn rt_alloc_raw: (size :i64) :ptr lib "c"
extern fn rt_free_raw: (ptr :ptr) lib "c"
extern fn rt_ptr_add: (ptr :ptr, delta :i64) :ptr lib "c"
extern fn rt_ptr_add_nonnull: (ptr :ptr, delta :i64) :ptr lib "c"
extern fn rt_write_u8: (ptr :ptr, value :i64) lib "c"
extern fn rt_read_u8: (ptr :ptr) :i64 lib "c"
extern fn rt_managed_from_slice: (src :ptr, len :i64) :str lib "c"
extern fn rt_managed_len: (value :&str) :i64 lib "c"

@[test]
pub fn ffi_null_check_on_raw_pointer: () :bool {
    // Must not crash, and must be true: rt_alloc_raw(8) is never NULL.
    set buffer = rt_alloc_raw(8)
    if buffer == 0 {
        return false
    }
    rt_free_raw(buffer)
    return true
}

@[test]
pub fn ffi_write_and_read_byte_at_offset: () :bool {
    set buffer = rt_alloc_raw(4)
    if buffer == 0 {
        return false
    }
    // Byte 0 stays untouched while byte 3 is written: this only holds if
    // rt_ptr_add computes a real address rather than re-reading offset 0.
    rt_write_u8(buffer 0x41)
    rt_write_u8(rt_ptr_add(buffer 3) 0xFA)
    set ok = rt_read_u8(buffer) == 0x41 && rt_read_u8(rt_ptr_add(buffer 3)) == 0xFA
    rt_free_raw(buffer)
    return ok
}

@[test]
pub fn ffi_nonnull_pointer_offset_preserves_byte_stride: () :bool {
    set buffer = rt_alloc_raw(8)
    if buffer == 0 {
        return false
    }
    rt_write_u8(rt_ptr_add_nonnull(buffer 5) 0x7B)
    set ok = rt_read_u8(rt_ptr_add_nonnull(buffer 5)) == 0x7B
    rt_free_raw(buffer)
    return ok
}

@[test]
pub fn ffi_distinct_raw_pointers_compare_by_address: () :bool {
    set first = rt_alloc_raw(4)
    set second = rt_alloc_raw(4)
    if first == 0 || second == 0 {
        if first != 0 { rt_free_raw(first) }
        if second != 0 { rt_free_raw(second) }
        return false
    }
    // Equal bytes are deliberately not NUL-terminated: pointer identity must
    // not read past either allocation as a string comparison would.
    rt_write_u8(first 0x41)
    rt_write_u8(rt_ptr_add(first 1) 0x42)
    rt_write_u8(rt_ptr_add(first 2) 0x43)
    rt_write_u8(rt_ptr_add(first 3) 0x44)
    rt_write_u8(second 0x41)
    rt_write_u8(rt_ptr_add(second 1) 0x42)
    rt_write_u8(rt_ptr_add(second 2) 0x43)
    rt_write_u8(rt_ptr_add(second 3) 0x44)
    set distinct = first != second
    rt_free_raw(first)
    rt_free_raw(second)
    return distinct
}

@[test]
pub fn ffi_raw_buffer_to_managed_string_keeps_embedded_nul: () :bool {
    set buffer = rt_alloc_raw(4)
    if buffer == 0 {
        return false
    }
    rt_write_u8(buffer 0x41)
    rt_write_u8(rt_ptr_add(buffer 1) 0x00)
    rt_write_u8(rt_ptr_add(buffer 2) 0x42)
    rt_write_u8(rt_ptr_add(buffer 3) 0x43)
    set as_str = rt_managed_from_slice(buffer 4)
    // Length 4, not 2: a strlen-based copy would have stopped at the NUL.
    set ok = rt_managed_len(as_str) == 4
    rt_free_raw(buffer)
    return ok
}

@[test]
pub fn ffi_ptr_add_of_null_stays_null: () :bool {
    // rt_ptr_add must propagate NULL rather than building an address from it.
    set nothing = rt_ptr_add(0 8)
    return nothing == 0
}

// ── Sandbox policy: two roots, and what it does not open ────────────────
// The sandbox denies every absolute path outside the working directory, and
// authorising the tool home is a SECOND root rather than a widening of the
// first. These tests pin both halves: the exception is narrow, and it does not
// become a general escape.

extern fn rt_sbx_get_root: () :str lib "c"
extern fn rt_sbx_set_tool_home: (path :&str) lib "c"
extern fn rt_sbx_get_tool_home: () :str lib "c"
extern fn pal_sbx_permit: (path :&str) :bool lib "c"

// A path under the tool home is allowed ONLY once the home has been authorised.
// Before that, the default is to deny, which is what every program that never
// opts in gets.
@[test]
pub fn sbx_the_tool_home_is_denied_until_it_is_authorised: () :bool {
    set home = "/home/Evelyn/.owl" :str
    return !pal_sbx_permit(home)
}

@[test]
pub fn sbx_authorising_the_tool_home_permits_it: () :bool {
    /! A directory that exists, because the grant is stored resolved and a path
        whose deepest existing ancestor is "/" would collapse to just that. !/
    set home = "/home/Evelyn/.owl" :str
    rt_sbx_set_tool_home(home)
    set got = rt_sbx_get_tool_home()
    if got != home { return false }
    return pal_sbx_permit(home)
}

@[test]
pub fn sbx_authorising_one_home_does_not_open_another: () :bool {
    set home = "/home/Evelyn/.owl" :str
    set other = "/var/owl_probe_elsewhere" :str
    rt_sbx_set_tool_home(home)
    return !pal_sbx_permit(other)
}

@[test]
pub fn sbx_traversal_out_of_the_tool_home_is_still_refused: () :bool {
    set home = "/home/Evelyn/.owl" :str
    rt_sbx_set_tool_home(home)
    /! Lexical normalisation happens before the prefix test, so this is a
        denial on the text and not on the filesystem. !/
    return !pal_sbx_permit("/home/Evelyn/.owl/../../../tmp")
}

@[test]
pub fn sbx_a_sibling_of_the_tool_home_is_not_under_it: () :bool {
    set home = "/home/Evelyn/.owl" :str
    rt_sbx_set_tool_home(home)
    /! "/home/Evelyn/.owlX" shares the prefix as a string but is a different
        directory; the prefix test has to require the separator. !/
    return !pal_sbx_permit("/home/Evelyn/.owlX")
}

@[test]
pub fn sbx_revoking_the_tool_home_denies_it_again: () :bool {
    set home = "/home/Evelyn/.owl" :str
    rt_sbx_set_tool_home(home)
    rt_sbx_set_tool_home("")
    return !pal_sbx_permit(home)
}
