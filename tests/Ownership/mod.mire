// Ownership family: a borrow is used while the owner remains valid.
load mire::vec
load mire::str

@[test]
pub fn borrowed_string_is_readable: () :bool {
    set value = "ownership"
    set view = &value
    set same = value == "ownership"
    return same
}

// `move::(src) to dst` reached the lowering's catch-all arm, so no slot was ever
// created for `dst`. The borrow checker had already accepted and bound the name,
// which made the failure surface as an llc error on an unrelated line:
//
//     llc: error: use of undefined value '@dst'
//
// pointing at the *use* of the moved value rather than at the move. These pin
// the three shapes it can appear in.

@[test]
pub fn moved_binding_is_usable: () :bool {
    set source = "moved"
    move::(source) to destination
    return destination == "moved"
}

@[test]
pub fn move_overwrites_an_existing_binding: () :bool {
    set source = "new"
    set destination = "old"
    move::(source) to destination
    // Before the fix this still compared equal to "old": the destination kept
    // the value it already had, because nothing was ever stored into it.
    return destination == "new"
}

@[test]
pub fn move_inside_a_loop_is_usable: () :bool {
    set total = 0 mut
    set i = 0 mut
    while i < 3 {
        set value = i :i64
        move::(value) to carried
        set total += carried
        set i += 1
    }
    return total == 3
}

@[test]
pub fn find_loop_body_actually_runs: () :bool {
    set seen = 0 mut
    find x in [1 2 3] {
        set seen += x
    }
    // `find` had no arm in the MIR lowering and fell through to a catch-all, so
    // its body was never emitted. This built, linked and printed nothing at all.
    return seen == 6
}

@[test]
pub fn find_loop_returns_early: () :bool {
    set hit = 0 mut
    find x in [1 2 3] {
        if x > 1 {
            set hit = x
            return true
        }
    }
    return false
}

@[test]
pub fn outer_vector_survives_return_in_conditional_branch: () :bool {
    set values = [] :vec[str] mut
    set guard = 0 :i64
    if guard != 0 {
        return false
    }

    set i = 0 :i64 mut
    while i < 16 {
        set value = str::from::i64(i)
        set values = vec::push::str(values, value)
        // Allocate after the rebind so a premature free of `values` is reused
        // and caught in this iteration instead of surviving by allocator luck.
        set scratch = str::concat("iteration", value)
        set i += 1
    }
    return vec::len(values) == 16 && vec::get::str(values, 15) == "15"
}

@[test]
pub fn vector_string_push_owns_value_after_call: () :bool {
    set values = [] :vec[str] mut
    set i = 0 :i64 mut
    while i < 8 {
        set value = str::concat("owned-" str::from::i64(i))
        set values = vec::push::str(values value)
        set churn = str::concat("churn-" str::from::i64(i))
        set i += 1
    }
    return vec::len(values) == 8
        && vec::get::str(values 0) == "owned-0"
        && vec::get::str(values 7) == "owned-7"
}

fn make_owned_string_vector: () :vec[str] {
    set values = [] :vec[str] mut
    set i = 0 :i64 mut
    while i < 3 {
        set value = str::concat("item-" str::from::i64(i))
        set values = vec::push::str(values value)
        set i += 1
    }
    return values
}

fn make_vector_after_early_return: (empty :bool) :vec[str] {
    set values = [] :vec[str] mut
    if empty { return values }
    set values = vec::push::str(values str::concat("after-", "branch"))
    return values
}

@[test]
pub fn returned_string_vector_keeps_elements_alive: () :bool {
    set values = make_owned_string_vector()
    set churn = str::concat("allocation", " after return")
    return vec::len(values) == 3
        && vec::get::str(values 0) == "item-0"
        && vec::get::str(values 2) == "item-2"
}

@[test]
pub fn vector_return_survives_unselected_early_return: () :bool {
    set values = make_vector_after_early_return(false)
    return vec::len(values) == 1 && vec::get::str(values 0) == "after-branch"
}

@[test]
pub fn a_runtime_pointer_can_be_passed_twice: () :bool {
    // Every runtime and FFI signature is written `(ptr :ptr)`, and `ptr` is not
    // a recognised type name, so it arrived at the borrow checker as an
    // unresolved type and was treated as owning. Every raw pointer was then
    // single-use: reading it once and then handing it to something else was
    // rejected as a move, on the second call, with nothing in the message
    // pointing at pointers.
    set text = "borrowed twice"
    set as_pointer = text :ptr
    return read_len(as_pointer) == read_len(as_pointer)
}

fn read_len: (p :ptr) :i64 { return 14 }
