// Variable declarations and scalar type management

@[test]
pub fn variable_integer_mutation: () :bool {
    set count = 2 mut
    set count = count + 3

    // Tests integer variable with mutation
    return count == 5
}

@[test]
pub fn variable_boolean_declaration: () :bool {
    set enabled = true

    // Tests boolean variable declaration
    return enabled == true
}

@[test]
pub fn variable_f64_explicit_type: () :bool {
    set ratio = 2.5 :f64

    // Tests float variable with explicit type ascription
    return ratio > 2.0
}